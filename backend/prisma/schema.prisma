// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// 1. Role-Based Access Control (RBAC)
// ==========================================

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  users       User[]
}


// ==========================================
// 2. User & Core Profile Accounts
// ==========================================

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  password          String
  name              String?
  roleId            Int
  role              Role               @relation(fields: [roleId], references: [id])
  hostelId          Int?
  hostel            Hostel?            @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  status            String             @default("active") // "active", "suspended"
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  // Profile extensions
  studentProfile    Student?
  wardenProfile     Warden?
  securityProfile   SecurityStaff?
  staffProfile      Staff?
  
  // Audits & Utilities
  notifications     Notification[]
  auditLogs         AuditLog[]
  inventoryRequests InventoryRequest[]
  notices           Notice[]
  inOutLogs         InOutLog[]
  verifiedPayments  FeePayment[]
  generatedReceipts FeeReceipt[]
  allotmentTemplates AllotmentTemplate[]
  generatedReports  GeneratedReport[]
  reviewedRoomChanges RoomChangeRequest[]

  @@index([roleId])
  @@index([hostelId])
  @@index([resetToken])
}

// ==========================================
// College Management
// ==========================================

model College {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  address      String?
  city         String?
  contactEmail String?
  contactPhone String?
  status       String   @default("active") // "active", "inactive"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // If a college can have multiple hostels, you might want to link them later:
  // hostels   Hostel[]
}


// ==========================================
// 3. Hostel Setup & Hierarchy
// ==========================================

model Hostel {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  city         String?
  status       String   @default("Active") // "Active", "Pending", "Inactive"
  address      String?
  hasHostel    Boolean  @default(true)
  hasLibrary   Boolean  @default(true)
  hasInventory Boolean  @default(true)
  users        User[]
  blocks       Block[]
  wardens      Warden[]
  admissionApplications AdmissionApplication[]
  notices      Notice[]
  inOutLogs    InOutLog[]
  staff        Staff[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Block {
  id       Int      @id @default(autoincrement())
  name     String
  hostelId Int
  hostel   Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  floors   Floor[]

  @@index([hostelId])
}

model Floor {
  id      Int    @id @default(autoincrement())
  number  Int
  blockId Int
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  rooms   Room[]

  @@index([blockId])
}

model Room {
  id        Int         @id @default(autoincrement())
  number    String
  floorId   Int
  floor     Floor       @relation(fields: [floorId], references: [id], onDelete: Cascade)
  capacity  Int
  rent      Decimal     @db.Decimal(10, 2)
  beds      Bed[]
  furniture Furniture[]
  currentRoomRequests RoomChangeRequest[] @relation("CurrentRoom")
  requestedRoomRequests RoomChangeRequest[] @relation("RequestedRoom")

  @@index([floorId])
}

model Bed {
  id          Int          @id @default(autoincrement())
  number      String
  roomId      Int
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations Allocation[]

  @@index([roomId])
}

// ==========================================
// 4. Role Profiles
// ==========================================

model Student {
  id          Int          @id @default(autoincrement())
  userId      Int          @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  collegeId   String       @unique
  allocations Allocation[]
  leaves      LeaveRequest[]
  complaints  Complaint[]
  fees        Fee[]
  bookIssues  BookIssue[]
  reservations Reservation[]
  attendance  Attendance[]
  documents   StudentDocument[]
  roomChangeRequests RoomChangeRequest[]

  @@index([userId])
}

model Warden {
  id       Int    @id @default(autoincrement())
  userId   Int    @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  phone    String
  shift    String? @default("Day") // "Day", "Night", "Rotational"
  hostelId Int
  hostel   Hostel @relation(fields: [hostelId], references: [id])

  @@index([userId])
  @@index([hostelId])
}

model SecurityStaff {
  id       Int    @id @default(autoincrement())
  userId   Int    @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  phone    String

  @@index([userId])
}

// ==========================================
// 5. Hostel Actions & Operations
// ==========================================

model Allocation {
  id              Int                  @id @default(autoincrement())
  bedId           Int
  bed             Bed                  @relation(fields: [bedId], references: [id], onDelete: Restrict)
  studentId       Int
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  startDate       DateTime
  endDate         DateTime
  status          String               @default("active") // "active", "completed", "cancelled"
  allotmentLetter RoomAllotmentLetter?

  @@index([bedId])
  @@index([studentId])
}

model RoomAllotmentLetter {
  id           Int        @id @default(autoincrement())
  allocationId Int        @unique
  allocation   Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  referenceNo  String     @unique
  issuedDate   DateTime   @default(now())
  terms        String?    @db.Text
  signedBy     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([allocationId])
}

model LeaveRequest {
  id            Int      @id @default(autoincrement())
  studentId     Int
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  leaveType     String   @default("Personal") // "Home Visit", "Medical", "Family Function", "Personal", "Emergency", "Academic"
  reason        String   @db.Text
  destination   String?
  contactPhone  String?
  parentContact String?
  startDate     DateTime
  endDate       DateTime
  status        String   @default("pending") // "pending", "approved", "rejected"
  remarks       String?  @db.Text
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([startDate])
}


model Complaint {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String
  priority    String   @default("medium") // "low", "medium", "high"
  status      String   @default("open") // "open", "assigned", "resolved", "closed"
  createdAt   DateTime @default(now())

  @@index([studentId])
}

model Visitor {
  id             Int       @id @default(autoincrement())
  studentName    String
  fullName       String
  visitorPhone   String?
  visitorIdProof String?
  relationship   String
  purpose        String?   @db.Text
  checkIn        DateTime?
  checkOut       DateTime?
  status         String    @default("Pending") // "Pending", "Approved", "Rejected", "Checked-In", "Checked-Out"
  remarks        String?   @db.Text
  reviewedBy     String?
  wardenRemarks  String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  // @@index([studentId]) removed
}

model Furniture {
  id     Int    @id @default(autoincrement())
  name   String
  roomId Int
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  status String @default("good") // "good", "damaged", "under-maintenance"

  @@index([roomId])
}

model Fee {
  id          Int       @id @default(autoincrement())
  studentId   Int
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(10, 2)
  dueDate     DateTime
  status      String    @default("unpaid") // "unpaid", "pending_verification", "paid", "overdue", "rejected"
  paymentDate DateTime?

  // Relations
  payments    FeePayment[]
  receipts    FeeReceipt[]

  @@index([studentId])
}

model FeePayment {
  id              Int      @id @default(autoincrement())
  feeId           Int
  fee             Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  amountPaid      Decimal  @db.Decimal(10, 2)
  paymentMethod   String   // e.g., "Bank Transfer", "UPI", "Cash"
  transactionId   String?
  proofUrl        String?  // Payment proof image/document
  status          String   @default("pending_verification") // "pending_verification", "verified", "rejected"
  rejectionReason String?
  paymentDate     DateTime @default(now())
  verifiedById    Int?
  verifiedBy      User?    @relation(fields: [verifiedById], references: [id])
  verifiedAt      DateTime?

  receipt         FeeReceipt?

  @@index([feeId])
  @@index([verifiedById])
}

model FeeReceipt {
  id            Int      @id @default(autoincrement())
  feeId         Int
  fee           Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  paymentId     Int      @unique
  payment       FeePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receiptNumber String   @unique
  generatedById Int
  generatedBy   User     @relation(fields: [generatedById], references: [id])
  generatedAt   DateTime @default(now())

  @@index([feeId])
  @@index([paymentId])
  @@index([generatedById])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  present   Boolean
  remarks   String?

  @@index([studentId])
}

// ==========================================
// 6. Library Management
// ==========================================

model Book {
  id           Int           @id @default(autoincrement())
  title        String
  author       String
  isbn         String        @unique
  copiesCount  Int           @default(1)
  issues       BookIssue[]
  reservations Reservation[]
}

model BookIssue {
  id         Int       @id @default(autoincrement())
  bookId     Int
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Restrict)
  studentId  Int
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  issueDate  DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  fineAmount Decimal   @default(0.00) @db.Decimal(10, 2)

  @@index([bookId])
  @@index([studentId])
}

model Reservation {
  id              Int      @id @default(autoincrement())
  bookId          Int
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  studentId       Int
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reservationDate DateTime @default(now())
  status          String   @default("pending") // "pending", "fulfilled", "expired"

  @@index([bookId])
  @@index([studentId])
}

// ==========================================
// 7. Inventory Management
// ==========================================

model Supplier {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  contactInfo String?
  items       InventoryItem[]
}

model Category {
  id    Int             @id @default(autoincrement())
  name  String          @unique
  items InventoryItem[]
}

model InventoryItem {
  id         Int                @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category           @relation(fields: [categoryId], references: [id])
  supplierId Int
  supplier   Supplier           @relation(fields: [supplierId], references: [id])
  stockCount Int                @default(0)
  requests   InventoryRequest[]

  @@index([categoryId])
  @@index([supplierId])
}

model InventoryRequest {
  id          Int           @id @default(autoincrement())
  itemId      Int
  item        InventoryItem @relation(fields: [itemId], references: [id])
  requestedById Int
  requestedBy User          @relation(fields: [requestedById], references: [id])
  quantity    Int
  status      String        @default("pending") // "pending", "approved", "rejected"

  @@index([itemId])
  @@index([requestedById])
}

// ==========================================
// 8. System Audits & Utilities
// ==========================================

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  module      String   @default("System")
  action      String
  description String?
  status      String   @default("Success")
  ipAddress   String?
  userAgent   String?
  oldData     String?
  newData     String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// 9. Global Notices
// ==========================================

model Notice {
  id          Int       @id @default(autoincrement())
  title       String
  content     String?
  isActive    Boolean   @default(true)
  scheduledAt DateTime?
  expiresAt   DateTime?
  priority    String    @default("General") // "General", "Urgent", "Maintenance", "Event"
  hostelId    Int?
  hostel      Hostel?   @relation(fields: [hostelId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById Int
  createdBy   User      @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([hostelId])
}

// ==========================================
// 10. Document & Log Extensions
// ==========================================

model StudentDocument {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentType String   // "Aadhar", "Income", "Admission", "Custom"
  name         String
  fileUrl      String
  uploadedAt   DateTime @default(now())

  @@index([studentId])
}

model InOutLog {
  id          Int      @id @default(autoincrement())
  userType    String   // "Student", "Staff", "Visitor"
  direction   String   // "IN", "OUT"
  name        String   // Can be name or ID
  reason      String?
  timestamp   DateTime @default(now())
  hostelId    Int?
  hostel      Hostel?  @relation(fields: [hostelId], references: [id])
  loggedById  Int
  loggedBy    User     @relation(fields: [loggedById], references: [id])

  @@index([hostelId])
  @@index([loggedById])
}

// 12. Staff Management (Non-system staff directory)
// ==========================================

// Physical staff (cleaners, maintenance, etc.) — no system login
model Staff {
  id          Int              @id @default(autoincrement())
  userId      Int?             @unique
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  phone       String?
  email       String?
  designation String           // e.g., "Cleaning", "Maintenance", "Cook", "Guard"
  hostelId    Int
  hostel      Hostel           @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  status      String           @default("active") // "active", "inactive"
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  attendance  StaffAttendance[]

  @@index([hostelId])
}

model StaffAttendance {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime
  present   Boolean
  remarks   String?

  @@index([staffId])
}

// 11. Student Registration & Admission
// ==========================================

model RegistrationConfig {
  id        Int      @id @default(autoincrement())
  hostelId  Int?     // null = global default
  config    Json     // { fields: [...], documents: [...] }
  updatedAt DateTime @updatedAt
}

model AdmissionApplication {
  id        Int      @id @default(autoincrement())
  data      Json     // all field values submitted by student
  documents Json     // list of uploaded file paths { key, label, path }
  status    String   @default("pending") // pending | approved | rejected
  remarks   String?
  hostelId  Int?
  hostel    Hostel?  @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostelId])
  @@index([status])
}

// ==========================================
// Allotment Template Upload
// ==========================================

model AllotmentTemplate {
  id                  Int      @id @default(autoincrement())
  name                String
  description         String?  @db.Text
  filePath            String
  fileName            String
  fileType            String   // "pdf" or "docx"
  imagePath           String?
  imageFileName       String?
  isActive            Boolean  @default(true)
  uploadedBy          Int?
  user                User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // PDF section uploads
  headerPdfPath       String?
  headerPdfName       String?
  footerPdfPath       String?
  footerPdfName       String?
  mainPdfPath         String?
  mainPdfName         String?
  termsPdfPath        String?
  termsPdfName        String?

  @@index([uploadedBy])
}

// ==========================================
// 10. Generated Reports History
// ==========================================

model GeneratedReport {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   // "Student", "Allocation", "Fee", "Visitor", "Complaint", "Leave", "Staff", "Furniture"
  format      String   // "Excel", "PDF", "CSV"
  filters     String?  @db.Text // JSON metadata of applied filters
  generatedBy String
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([createdById])
  @@index([category])
  @@index([createdAt])
}

// ==========================================
// 12. Room Change Request
// ==========================================

model RoomChangeRequest {
  id              Int      @id @default(autoincrement())
  studentId       Int
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currentRoomId   Int
  currentRoom     Room     @relation("CurrentRoom", fields: [currentRoomId], references: [id])
  requestedRoomId Int?
  requestedRoom   Room?    @relation("RequestedRoom", fields: [requestedRoomId], references: [id])
  reason          String   @db.Text
  status          String   @default("Pending") // "Pending", "Approved", "Rejected"
  remarks         String?  @db.Text
  rejectionReason String?  @db.Text
  reviewedById    Int?
  reviewedBy      User?    @relation(fields: [reviewedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([currentRoomId])
  @@index([reviewedById])
}
